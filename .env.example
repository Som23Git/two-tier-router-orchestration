# Copy to .env and fill in the values. Nothing else needs to change.

# Elastic Stack version (Elasticsearch and Kibana images). 9.5.6 is the newest
# published image as of 2026-11-06; 9.5.7 is announced but not on the registry yet.
STACK_VERSION=9.5.6

# Password for the `elastic` superuser (you log in to Kibana with it)
ELASTIC_PASSWORD=<choose-a-password>
# Password Kibana uses internally (kibana_system user)
KIBANA_PASSWORD=<choose-another-password>
# At least 32 random characters, for example: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=<32+-random-characters>

# OpenRouter (https://openrouter.ai/settings/keys): the LLM baselines and the
# router's fallback. The only external service this stack calls.
OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_RPM=120

# Router: Laya's labels are used when its probability for each needed answer
# is at least this high; otherwise a small LLM classifies the message.
ROUTER_MIN_PROBABILITY=0.7

# Benchmark cost model: what one machine running Laya costs per hour. Your
# laptop is free, so price it like a server you would rent for the job.
LAYA_HOURLY_USD=0.10

# Host ports (start.sh picks free ones automatically if these are taken)
ES_PORT=9200
KIBANA_PORT=5601
APP_PORT=8080
LAYA_PORT=8000

# Resources (Docker Desktop needs about 8 GB for the whole stack)
ES_HEAP=1g
ES_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=1536m
LAYA_MEM_LIMIT=3g
LAYA_THREADS=4
